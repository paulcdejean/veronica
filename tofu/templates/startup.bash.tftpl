#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install --yes ca-certificates curl git jq openssl xz-utils

node_archive="node-v${node_version}-linux-x64.tar.xz"
node_dir="/usr/local/lib/node-v${node_version}-linux-x64"

if [ ! -x "$${node_dir}/bin/node" ]; then
  curl --fail --silent --show-error --location \
    "https://nodejs.org/dist/v${node_version}/$${node_archive}" \
    --output "/tmp/$${node_archive}"
  printf '%s  %s\n' \
    "${node_linux_x64_sha256}" "/tmp/$${node_archive}" \
    | sha256sum --check --status
  tar --extract --xz --file "/tmp/$${node_archive}" --directory /usr/local/lib
fi

ln --symbolic --force "$${node_dir}/bin/node" /usr/local/bin/node
ln --symbolic --force "$${node_dir}/bin/npm" /usr/local/bin/npm
ln --symbolic --force "$${node_dir}/bin/npx" /usr/local/bin/npx
ln --symbolic --force "$${node_dir}/bin/corepack" /usr/local/bin/corepack

npm install --global --prefix /usr/local \
  "openclaw@${openclaw_version}" \
  "@openai/codex@${codex_version}"

if ! id openclaw >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash openclaw
fi

install -d -o openclaw -g openclaw -m 0700 \
  /home/openclaw/.openclaw \
  /home/openclaw/.openclaw/workspace \
  /home/openclaw/.codex

if [ ! -s /home/openclaw/.openclaw/.env ]; then
  if [ -s /etc/openclaw/gateway.env ]; then
    install -o openclaw -g openclaw -m 0600 \
      /etc/openclaw/gateway.env /home/openclaw/.openclaw/.env
  else
    # Subshell so the tightened umask cannot leak into the rest of the boot.
    (
      umask 0077
      printf 'OPENCLAW_GATEWAY_TOKEN=%s\n' "$(openssl rand -hex 32)" \
        >/home/openclaw/.openclaw/.env
    )
    chown openclaw:openclaw /home/openclaw/.openclaw/.env
  fi
fi

# Deny-all placeholder (a Twilio test number no caller ID can match) in case
# the allowlist secret fetch below fails on this boot; a successful fetch
# overwrites it.
if ! grep -q '^VOICE_ALLOW_FROM=' /home/openclaw/.openclaw/.env; then
  printf 'VOICE_ALLOW_FROM=+15005550006\n' >>/home/openclaw/.openclaw/.env
fi

# Inject the env lines that OpenTofu placed in Secret Manager (the Twilio
# credentials in one secret, the caller allowlist in the other), replacing
# any previous values so a rotated payload takes effect on reboot. Retries
# cover first-boot IAM propagation on the secret bindings; a failed fetch
# leaves the existing values so it cannot brick the boot.
for voice_secret in '${voice_env_secret}' '${voice_allowlist_secret}'; do
  voice_env=''
  for voice_env_attempt in 1 2 3 4 5 6; do
    if metadata_token=$(curl --fail --silent --show-error \
        --header 'Metadata-Flavor: Google' \
        'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
        | jq --raw-output '.access_token') \
      && voice_env=$(curl --fail --silent --show-error \
        --header "Authorization: Bearer $${metadata_token}" \
        "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$${voice_secret}/versions/latest:access" \
        | jq --raw-output '.payload.data' | base64 --decode); then
      break
    fi
    voice_env=''
    echo "secret $${voice_secret} fetch failed (attempt $${voice_env_attempt}); retrying" >&2
    sleep 10
  done
  if [ -n "$${voice_env}" ]; then
    while IFS= read -r voice_env_line; do
      [ -n "$${voice_env_line}" ] || continue
      sed -i "/^$${voice_env_line%%=*}=/d" /home/openclaw/.openclaw/.env
      printf '%s\n' "$${voice_env_line}" >>/home/openclaw/.openclaw/.env
    done <<<"$${voice_env}"
  else
    echo "secret $${voice_secret} unavailable; keeping existing values" >&2
  fi
done

# Install the plugin before writing the config that references it, so the
# install run does not warn about it being missing.
runuser --user openclaw -- env HOME=/home/openclaw \
  /usr/local/bin/openclaw plugins install \
  "npm:@openclaw/codex@${codex_plugin_version}" --force --pin

cat >/home/openclaw/.openclaw/openclaw.json <<'JSON'
{
  gateway: {
    mode: "local",
    port: 18789,
    bind: "loopback",
    auth: {
      mode: "token",
      token: "$${OPENCLAW_GATEWAY_TOKEN}",
    },
    http: {
      endpoints: {
        // Off by default; the voice bridge drives the agent through this
        // OpenResponses endpoint on loopback.
        responses: {
          enabled: true,
        },
      },
    },
  },
  plugins: {
    entries: {
      codex: { enabled: true },
    },
  },
  agents: {
    defaults: {
      model: { primary: "openai/gpt-5.5" },
      workspace: "/home/openclaw/.openclaw/workspace",
    },
  },
}
JSON
chown openclaw:openclaw /home/openclaw/.openclaw/openclaw.json
chmod 0600 /home/openclaw/.openclaw/openclaw.json

cat >/etc/systemd/system/openclaw-gateway.service <<'UNIT'
[Unit]
Description=OpenClaw Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
Environment=HOME=/home/openclaw
Environment=OPENCLAW_SERVICE_REPAIR_POLICY=external
EnvironmentFile=/home/openclaw/.openclaw/.env
ExecStart=/usr/local/bin/openclaw gateway --port 18789
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStartSec=30
TimeoutStopSec=30
SuccessExitStatus=0 143
OOMPolicy=continue
KillMode=control-group

[Install]
WantedBy=multi-user.target
UNIT

# The voice bridge answers Twilio ConversationRelay: it serves the signed
# voice webhook and the relay WebSocket on the Cloudflare-fronted port, and
# forwards caller turns to the gateway's OpenResponses endpoint. It is
# downloaded from the bootstrap bucket and pinned to the checksum of the
# file in the repo; retries cover first-boot IAM propagation on the bucket
# binding, and a wrong or missing download aborts the bootstrap.
install -d -m 0755 /opt/voice-bridge
for bridge_attempt in 1 2 3 4 5 6; do
  if metadata_token=$(curl --fail --silent --show-error \
      --header 'Metadata-Flavor: Google' \
      'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
      | jq --raw-output '.access_token') \
    && curl --fail --silent --show-error \
      --header "Authorization: Bearer $${metadata_token}" \
      'https://storage.googleapis.com/storage/v1/b/${bootstrap_bucket}/o/${voice_bridge_object}?alt=media' \
      --output /opt/voice-bridge/index.mjs; then
    break
  fi
  echo "voice bridge download failed (attempt $${bridge_attempt}); retrying" >&2
  sleep 10
done
printf '%s  %s\n' '${voice_bridge_sha256}' /opt/voice-bridge/index.mjs \
  | sha256sum --check --status

cat >/opt/voice-bridge/package.json <<'PKG'
{
  "name": "voice-bridge",
  "private": true,
  "type": "module",
  "dependencies": {
    "ws": "${ws_version}"
  }
}
PKG

npm install --prefix /opt/voice-bridge --omit=dev --no-audit --no-fund

# The bridge runs as the unprivileged openclaw user; make sure everything
# under /opt/voice-bridge is world-readable regardless of the boot umask.
chmod --recursive go+rX /opt/voice-bridge

cat >/etc/systemd/system/voice-bridge.service <<'UNIT'
[Unit]
Description=Twilio ConversationRelay bridge to the OpenClaw gateway
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
Environment=HOME=/home/openclaw
Environment=VOICE_BRIDGE_PORT=${voice_webhook_port}
Environment=VOICE_HOSTNAME=${voice_hostname}
Environment="VOICE_GREETING=${voice_greeting}"
EnvironmentFile=/home/openclaw/.openclaw/.env
ExecStart=/usr/local/bin/node /opt/voice-bridge/index.mjs
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable openclaw-gateway.service voice-bridge.service
# Restart rather than start: on reboots the services come up in parallel with
# this script and would otherwise keep the pre-injection environment.
systemctl restart openclaw-gateway.service voice-bridge.service
